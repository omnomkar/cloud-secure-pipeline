# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored - it's where your actual settings live.

region              = "us-east-1"
project_name        = "secure-cloud-pipeline"
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
availability_zone   = "us-east-1a"
nat_instance_type   = "t3.nano"
k3s_instance_type   = "t3.small"
k3s_version         = "v1.36.2+k3s1"
github_org          = "your-github-username-or-org"
github_repo         = "secure-cloud-pipeline"

# Required, sensitive, no default - this is the actual runtime secret the
# app reads from Secrets Manager. Replace with a real value; never commit
# the real terraform.tfvars (it's gitignored already).
app_secret_value    = "REPLACE_ME_WITH_A_REAL_SECRET"
